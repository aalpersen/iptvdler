# Copy to keystore.properties (git-ignored) and fill in to sign Android release builds.
# Create a keystore once (keep it and the passwords safe; you need the same key for every update):
#   keytool -genkeypair -v -keystore iptvdler-release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias iptvdler
# storeFile is relative to the project root (or absolute). *.jks files are git-ignored.
storeFile=iptvdler-release.jks
storePassword=
keyAlias=iptvdler
keyPassword=
